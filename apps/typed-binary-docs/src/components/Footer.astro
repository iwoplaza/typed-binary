---
import Default from '@astrojs/starlight/components/Footer.astro';

const year = new Date().getFullYear();
---

<Default />

<div class="tb-copyright">
  <span>&copy; {year} Iwo Plaza</span>
  <span class="tb-copyright-sep" aria-hidden="true"></span>
  <a href="https://github.com/iwoplaza/typed-binary/blob/main/LICENSE">MIT License</a>
</div>

<style>
  .tb-copyright {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem 0.75rem;
    margin-top: 3rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--sl-color-hairline);
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }

  .tb-copyright-sep {
    width: 0.3rem;
    height: 0.3rem;
    background: var(--tb-gradient);
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  a:hover {
    color: var(--sl-color-accent);
  }
</style>
